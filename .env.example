MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_DATABASE=codex_workspace_bot
MYSQL_USER=codex_workspace_bot
CODEX_WORKSPACE_BOT_DB_PASSWORD=replace-with-local-app-password
# Generate each once with: openssl rand -base64 32
# Keep these stable across bot restarts until all retained S05 records using an old key expire.
CODEX_WORKSPACE_BOT_ATTACHMENT_KEY_V1=replace-with-base64-32-byte-key
CODEX_WORKSPACE_BOT_ACTION_RESULT_KEY_V1=replace-with-base64-32-byte-key
# Required before setting schedule.enabled=true. Keep stable until all S06
# records using an old version have expired or been migrated.
CODEX_WORKSPACE_BOT_SCHEDULE_PAYLOAD_KEY_V1=replace-with-base64-32-byte-key
CODEX_WORKSPACE_BOT_SCHEDULE_OWNER_HMAC_KEY_V1=replace-with-base64-32-byte-key
MYSQL_HOST_PORT=3306
# Required only when observability.langfuse.enabled=true. Never commit real
# Langfuse project keys; business payloads are intentionally plaintext there.
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
